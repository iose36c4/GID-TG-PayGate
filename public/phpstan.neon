includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5
    paths:
        - app
        - database
        - routes
    excludePaths:
        - .phpstorm.meta.php
        - bootstrap
        - storage
        - public
        - config
        - vendor
        - node_modules
    ignoreErrors:
        - '#^Access to an undefined property .*::$#'
    checkMissingIterableValueType: false